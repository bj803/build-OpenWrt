#
# ImmortalWrt x86/64 —— HomeIPTV（192.168.10.77）固件配置
#
# 这套配置是给 10.77 那台「IPTV / Docker / xteve」业务机用的：
#   eth0 = 内网 192.168.10.77（192.168.10.0/24，直连 iKuai 192.168.10.1）
#   eth1 = 运营商 IPTV 侧 192.168.100.103（IGMP 组播源）
#   msd_lite 把 IGMP 组播转成 HTTP（192.168.10.77:23234），xteve 跑在 docker 里（/opt 数据盘）
#
# 写法：只写「目标 + 必须显式指定的选项 + 要装的包」，其余由 workflow 里的 make defconfig 展开。
#      这样跨分支（openwrt-24.10 / 25.12）都能用，不必维护 7000 行的完整 dump。
#      包名都与 immortalwrt/packages、immortalwrt/luci 的 openwrt-25.12 分支逐一核对过；
#      万一某个包在该分支不存在，defconfig 只会跳过它并打警告，不会让构建失败。
#

#
# 目标平台
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

#
# 镜像格式：EFI 整盘 img（squashfs + f2fs overlay），与 10.77 现网分区布局一致
#   sda1 128M vfat /boot（EFI）  sda2 1024M squashfs /rom + f2fs /overlay
#
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

#
# 管理界面与基础工具
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_sysfsutils=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ImmortalWrt 自带的中文向默认设置（现网 10.77 上就有这两个包）
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_autocore=y

#
# IPTV：IGMP 组播 → HTTP
#
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
# udpxy 一并装上，但默认 disabled（现网也是只跑 msd_lite，留着备用）
CONFIG_PACKAGE_udpxy=y
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_luci-i18n-udpxy-zh-cn=y

#
# Docker（xteve 容器：alturismo/xteve_guide2go）
#
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y

# docker 的网桥/网络命名空间所需内核模块（iptables 关掉，所以不需要 iptables 相关模块）
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-nf-nat=y

# BBR 拥塞控制：走 immortalwrt **官方 kmod 包**（不是改内核片段）
#   KernelPackage/tcp-bbr（package/kernel/linux/modules/netsupport.mk）：
#   KCONFIG=CONFIG_TCP_CONG_BBR（=m 模块）、AUTOLOAD 自动加载、包自带
#   /etc/sysctl.d/12-tcp-bbr.conf → net.ipv4.tcp_congestion_control=bbr
#   为什么不用内核片段 =y：那会让 choice 成员 DEFAULT_BBR 变可见，kconfig 交互提问（CI 无 stdin）
#   直接导致 target/linux 构建失败（Nikki 第一次构建就是这么挂的）。
CONFIG_PACKAGE_kmod-tcp-bbr=y

#
# 数据盘与文件系统：/opt = sdb1(ext4) 挂 docker 数据根 /opt/docker
#
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

#
# 网卡驱动（ESXi 用 VMXNET3；顺手把常见型号带上，换机型不用重编）
#
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y

#
# 说明：BBR / fq 不在这里配置。
# 内核选项必须写进 target/linux/**/config-<版本> 片段（见 diy-part1.sh），
# 运行时默认值由 diy-part2.sh 写进 /etc/sysctl.conf。
#
