# ------------------------------ Nikki 核心配置（重点） ------------------------------
# 已核实（直接拉取 nikkinikki-org/OpenWrt-nikki 源码确认）：
# - luci-app-nikki 依赖 +nikki
# - nikki 依赖 +mihomo（虚拟包，由 mihomo-meta 或 mihomo-alpha 二选一提供，两者互斥）
# - mihomo-meta 需要 golang/host 编译，已确认 immortalwrt/packages(openwrt-25.12)
#   自带 lang/golang，无需额外加源
# - 强制要求 firewall4，本配置已默认启用，天然满足
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_nikki=y

# 内核选择：mihomo-meta（稳定版）。不要同时选 mihomo-alpha，两者 CONFLICTS。
# 如果你想尝鲜最新特性，把下面两行的 y 互换即可。
CONFIG_PACKAGE_mihomo-meta=y
# CONFIG_PACKAGE_mihomo-alpha is not set

# Nikki 官方文档列出的必需依赖，显式列出便于核对（大部分会被包管理器自动 select，
# 这里写出来是为了完整性和可读性，不会冲突）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y

# BBR 拥塞控制：走 immortalwrt **官方 kmod 包**（不是改内核片段）
#   package/kernel/linux/modules/netsupport.mk 里 KernelPackage/tcp-bbr：
#     KCONFIG:=CONFIG_TCP_CONG_BBR（=m 模块）、FILES:=net/ipv4/tcp_bbr.ko、AUTOLOAD 自动加载，
#     并自带 /etc/sysctl.d/12-tcp-bbr.conf → net.ipv4.tcp_congestion_control=bbr
#   2026-09-18 修正：原先用内核片段写 CONFIG_TCP_CONG_BBR=y 会让 choice 成员 DEFAULT_BBR 变可见，
#   kconfig 交互提问（CI 无 stdin）直接把构建搞挂；改成模块路径后这个坑不存在了。
CONFIG_PACKAGE_kmod-tcp-bbr=y

# x86-64硬件网卡基础驱动（已确认使用标准ASCII连字符，非Unicode特殊字符）
CONFIG_PACKAGE_kmod-8139cp=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-vmxnet3=y

# 工具库
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libnl-tiny=y
CONFIG_PACKAGE_libnettle=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_libnghttp2=y

# ------------------------------ 关于 BBR / fq（2026-09-15 追加说明） ------------------------------
# 这里**故意不写** CONFIG_KERNEL_TCP_CONG_BBR / CONFIG_KERNEL_NET_SCH_FQ，因为写了也没用：
#   1) workflow 里 `make defconfig` 实际执行的是 include/toplevel.mk:120-124 的
#      `scripts/config/conf --defconfig=.config Config.in`；
#   2) OpenWrt 自带的这份 kconfig 在 scripts/config/confdata.c 的 conf_read()
#      （第 486-504 行处理 `CONFIG_xxx=value`、第 450-459 行处理 `# CONFIG_xxx is not set`）
#      对符号表里找不到的符号一律 `conf_warning("unknown symbol") + continue`，不会写回 .config；
#   3) 而 config/Config-kernel.in 里没有任何 TCP_CONG_* / NET_SCH_FQ 定义（25.12 全树 469 个符号里都没有，
#      24.10 / 23.05 也一样），所以写进去会在 defconfig 那一步被静默丢掉，编出来照样没 BBR。
#
# BBR 真正生效的两处（都已做好，见核查报告第十四节）：
#   - diy-part1.sh ：往 target/linux/{generic,x86}/config-<版本> 片段里补
#                    CONFIG_TCP_CONG_BBR=y 与 CONFIG_NET_SCH_FQ=y
#   - diy-part2.sh ：往固件默认 /etc/sysctl.conf 里写
#                    net.core.default_qdisc=fq / net.ipv4.tcp_congestion_control=bbr
# 刷机后用 `sysctl net.ipv4.tcp_available_congestion_control` 应看到 "reno cubic bbr" 来验收。
